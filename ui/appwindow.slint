import { ScrollView } from "std-widgets.slint";

// ─── Reusable custom components ────────────────────────────────────────────

// Toggle switch — replaces ugly CheckBox
component Toggle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 24px;

    Rectangle {
        border-radius: 12px;
        background: root.checked
            ? (root.enabled ? #2563eb : #93c5fd)
            : (root.enabled ? #cbd5e1 : #e2e8f0);
        animate background { duration: 120ms; }

        Rectangle {
            x: root.checked ? parent.width - self.width - 3px : 3px;
            y: 3px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: #ffffff;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000022;
            animate x { duration: 120ms; easing: ease-in-out; }
        }

        ta := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

// A single setting row: label on left, toggle on right
component SettingRow {
    in property <string> label: "";
    in property <string> sublabel: "";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: root.sublabel == "" ? 40px : 52px;

    HorizontalLayout {
        alignment: space-between;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: 13px;
                color: root.enabled ? #1e293b : #94a3b8;
                overflow: elide;
                wrap: no-wrap;
            }
            if root.sublabel != "": Text {
                text: root.sublabel;
                font-size: 11px;
                color: root.enabled ? #64748b : #cbd5e1;
            }
        }

        Toggle {
            checked <=> root.checked;
            enabled: root.enabled;
            toggled(v) => { root.toggled(v); }
        }
    }
}


// Pill-style tab button for the sidebar
component SideTabBtn {
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked();
    height: 44px;

    Rectangle {
        border-radius: 8px;
        background: root.selected ? #2563eb : transparent;
        animate background { duration: 100ms; }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 0px;

            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.selected ? 700 : 400;
                color: root.selected ? #ffffff : #475569;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
        }

        ta := TouchArea {
            clicked => { root.clicked(); }
        }

        // Hover state
        if !root.selected: Rectangle {
            border-radius: 8px;
            background: ta.has-hover ? #f1f5f9 : transparent;
        }
    }
}

// Rounded primary / secondary button
component Btn {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: 100px;

    btn-ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }

    Rectangle {
        border-radius: 7px;
        background: root.primary
            ? (root.enabled ? (btn-ta.has-hover ? #1d4ed8 : #2563eb) : #93c5fd)
            : (btn-ta.has-hover ? #f1f5f9 : #ffffff);
        border-width: root.primary ? 0px : 1px;
        border-color: #cbd5e1;
        animate background { duration: 80ms; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.primary ? 600 : 400;
                color: root.primary ? #ffffff : (root.enabled ? #374151 : #9ca3af);
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

// Custom dropdown (ComboBox replacement)
component Dropdown {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    callback selected(int);
    height: 36px;

    drop-ta := TouchArea {
        clicked => {
            // Cycling through options on click (simple approach for Slint)
            root.current-index = Math.mod(root.current-index + 1, root.model.length);
            root.selected(root.current-index);
        }
    }

    Rectangle {
        border-radius: 7px;
        background: drop-ta.has-hover ? #f8fafc : #ffffff;
        border-width: 1px;
        border-color: drop-ta.has-hover ? #94a3b8 : #e2e8f0;
        animate border-color { duration: 80ms; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            alignment: space-between;
            Text {
                text: root.current-index < root.model.length ? root.model[root.current-index] : "";
                font-size: 13px;
                color: #1e293b;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "▾";
                font-size: 12px;
                color: #64748b;
                vertical-alignment: center;
            }
        }
    }
}

// Key badge display
component KeyBadge {
    in property <string> label: "";
    in-out property <bool> checked: false;
    callback toggled(bool);
    height: 30px;
    min-width: 48px;

    kta := TouchArea { clicked => { root.checked = !root.checked; root.toggled(root.checked); } }

    Rectangle {
        border-radius: 6px;
        background: root.checked ? #2563eb : (kta.has-hover ? #f1f5f9 : #ffffff);
        border-width: 1px;
        border-color: root.checked ? #2563eb : #e2e8f0;
        animate background { duration: 80ms; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: center;
            Text {
                text: root.label;
                font-size: 12px;
                font-weight: 600;
                color: root.checked ? #ffffff : #475569;
                vertical-alignment: center;
                horizontal-alignment: center;
                animate color { duration: 80ms; }
            }
        }
    }
}

// TextInput replacement (LineEdit)
component TextInput_ {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    callback edited(string);
    height: 36px;

    Rectangle {
        border-radius: 7px;
        background: root.enabled ? #ffffff : #f8fafc;
        border-width: 1px;
        border-color: inner-edit.has-focus ? #2563eb : #e2e8f0;
        animate border-color { duration: 80ms; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;

            inner-edit := TextInput {
                text <=> root.text;
                font-size: 13px;
                color: #1e293b;
                vertical-alignment: center;
                enabled: root.enabled;
                edited => { root.edited(self.text); }
            }
        }
    }
}


// ─── Main Settings Window ────────────────────────────────────────────────────

export component MainWindow inherits Window {
    title: "Minkey - Bảng Điều Khiển";
    preferred-width: 560px;
    preferred-height: 620px;
    min-width: 520px;
    min-height: 560px;
    background: #f1f5f9;
    default-font-family: "Segoe UI";

    // Public properties synced with backend
    in-out property <int> active-tab: 0;
    in-out property <int> selected-input-type: 0;
    in-out property <int> selected-code-table: 0;
    in-out property <bool> is-vietnamese: true;

    // Hotkey modifiers
    in-out property <bool> switch-ctrl: false;
    in-out property <bool> switch-alt: true;
    in-out property <bool> switch-win: false;
    in-out property <bool> switch-shift: false;
    in-out property <string> switch-key: "Z";
    in-out property <bool> switch-beep: true;

    // Tab 1: Typing Engine settings
    in-out property <bool> opt-modern-orthography: false;
    in-out property <bool> opt-fix-browser: true;
    in-out property <bool> opt-check-spelling: true;
    in-out property <bool> opt-restore-spelling: true;
    in-out property <bool> opt-allow-zfwj: false;
    in-out property <bool> opt-temp-off-spelling: false;
    in-out property <bool> opt-smart-switch: true;
    in-out property <bool> opt-upper-first: false;
    in-out property <bool> opt-remember-code: true;
    in-out property <bool> opt-other-language: true;
    in-out property <bool> opt-temp-off-openkey: false;

    // Tab 2: Macro settings
    in-out property <bool> opt-quick-telex: false;
    in-out property <bool> opt-use-macro: true;
    in-out property <bool> opt-macro-in-english: false;
    in-out property <bool> opt-macro-auto-caps: false;
    in-out property <bool> opt-quick-start-consonant: false;
    in-out property <bool> opt-quick-end-consonant: false;

    // Tab 3: System settings
    in-out property <bool> opt-modern-icon: false;
    in-out property <bool> opt-show-on-startup: false;
    in-out property <bool> opt-run-with-windows: true;
    in-out property <bool> opt-run-as-admin: false;
    in-out property <bool> opt-check-update: false;
    in-out property <bool> opt-desktop-shortcut: false;
    in-out property <bool> opt-fix-chromium: false;
    in-out property <bool> opt-use-clipboard: false;
    in-out property <bool> opt-support-metro: false;

    // Callbacks to Rust
    callback input-type-changed(int);
    callback code-table-changed(int);
    callback language-changed(bool);
    callback switch-hotkey-changed();
    callback setting-toggled(string, bool);
    callback open-macro-table();
    callback open-convert-tool();
    callback reset-defaults();
    callback check-update-clicked();
    callback open-github();
    callback close-window();
    callback exit-app();

    // ── Layout ──────────────────────────────────────────────────────────────
    HorizontalLayout {
        spacing: 0px;
        padding: 0px;

        // ── Left sidebar ──────────────────────────────────────────────────
        Rectangle {
            width: 160px;
            background: #1e293b;

            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 16px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 4px;

                // Logo area
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 4px;
                        alignment: start;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "Minkey";
                                font-size: 20px;
                                font-weight: 700;
                                color: #ffffff;
                            }
                            Text {
                                text: "Bộ gõ Tiếng Việt";
                                font-size: 10px;
                                color: #94a3b8;
                            }
                        }
                    }
                }

                // Divider
                Rectangle { height: 1px; background: #334155; }
                Rectangle { height: 8px; }

                SideTabBtn {
                    label: "⌨  Bộ gõ";
                    selected: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                SideTabBtn {
                    label: "✦  Gõ tắt";
                    selected: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                SideTabBtn {
                    label: "⚙  Hệ thống";
                    selected: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                SideTabBtn {
                    label: "ℹ  Thông tin";
                    selected: root.active-tab == 3;
                    clicked => { root.active-tab = 3; }
                }

                // Stretch space
                Rectangle { vertical-stretch: 1; }

                // Divider
                Rectangle { height: 1px; background: #334155; }
                Rectangle { height: 4px; }

                // Language toggle at bottom of sidebar
                Rectangle {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 4px;
                        spacing: 6px;
                        alignment: start;

                        // Việt button
                        Rectangle {
                            width: 58px;
                            height: 32px;
                            border-radius: 6px;
                            background: root.is-vietnamese ? #2563eb : #334155;
                            animate background { duration: 120ms; }
                            Text {
                                text: "Việt";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.is-vietnamese = true;
                                    root.language-changed(true);
                                }
                            }
                        }

                        // Anh button
                        Rectangle {
                            width: 58px;
                            height: 32px;
                            border-radius: 6px;
                            background: !root.is-vietnamese ? #2563eb : #334155;
                            animate background { duration: 120ms; }
                            Text {
                                text: "Anh";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    root.is-vietnamese = false;
                                    root.language-changed(false);
                                }
                            }
                        }
                    }
                }

            }
        }

        // ── Right content area ─────────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 16px;
            spacing: 10px;

            // ── TAB 0: Bộ gõ ───────────────────────────────────────────────
            if root.active-tab == 0: VerticalLayout {
                spacing: 10px;

                // Card: Input method + code table
                Rectangle {
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "PHƯƠNG THỨC NHẬP LIỆU";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }

                        HorizontalLayout {
                            spacing: 12px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Kiểu gõ"; font-size: 12px; color: #475569; font-weight: 600; }
                                Dropdown {
                                    model: ["Telex", "VNI", "Simple Telex 1", "Simple Telex 2"];
                                    current-index <=> root.selected-input-type;
                                    selected(v) => { root.input-type-changed(v); }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Bảng mã"; font-size: 12px; color: #475569; font-weight: 600; }
                                Dropdown {
                                    model: ["Unicode", "TCVN3 (ABC)", "VNI Windows", "Unicode Tổ hợp", "CP1258"];
                                    current-index <=> root.selected-code-table;
                                    selected(v) => { root.code-table-changed(v); }
                                }
                            }
                        }

                        // Switch hotkey row
                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        Text {
                            text: "PHÍM CHUYỂN ANH / VIỆT";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            KeyBadge {
                                label: "Ctrl";
                                checked <=> root.switch-ctrl;
                                toggled(v) => { root.switch-hotkey-changed(); }
                            }
                            KeyBadge {
                                label: "Alt";
                                checked <=> root.switch-alt;
                                toggled(v) => { root.switch-hotkey-changed(); }
                            }
                            KeyBadge {
                                label: "Win";
                                checked <=> root.switch-win;
                                toggled(v) => { root.switch-hotkey-changed(); }
                            }
                            KeyBadge {
                                label: "Shift";
                                checked <=> root.switch-shift;
                                toggled(v) => { root.switch-hotkey-changed(); }
                            }

                            Text {
                                text: "+";
                                font-size: 14px;
                                font-weight: 700;
                                color: #94a3b8;
                                vertical-alignment: center;
                            }

                            TextInput_ {
                                text <=> root.switch-key;
                                width: 46px;
                                edited(v) => { root.switch-hotkey-changed(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                Toggle {
                                    checked <=> root.switch-beep;
                                    toggled(v) => { root.switch-hotkey-changed(); }
                                }
                                Text {
                                    text: "Âm báo";
                                    font-size: 12px;
                                    color: #475569;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Card: Typing options
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;

                        Text {
                            text: "TÙY CHỌN GÕ";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }
                        Rectangle { height: 8px; }

                        ScrollView {
                            VerticalLayout {
                                spacing: 0px;
                                padding-right: 4px;

                                SettingRow {
                                    label: "Đặt dấu kiểu mới (oà, uý)";
                                    checked <=> root.opt-modern-orthography;
                                    toggled(v) => { root.setting-toggled("modern_orthography", v); }
                                }
                                SettingRow {
                                    label: "Sửa lỗi gợi ý trên trình duyệt";
                                    sublabel: "Chrome, Edge, Firefox, Excel…";
                                    checked <=> root.opt-fix-browser;
                                    toggled(v) => { root.setting-toggled("fix_browser", v); }
                                }
                                SettingRow {
                                    label: "Kiểm tra chính tả";
                                    checked <=> root.opt-check-spelling;
                                    toggled(v) => { root.setting-toggled("check_spelling", v); }
                                }
                                SettingRow {
                                    label: "Khôi phục từ sai khi nhấn dấu cách";
                                    checked <=> root.opt-restore-spelling;
                                    enabled: root.opt-check-spelling;
                                    toggled(v) => { root.setting-toggled("restore_spelling", v); }
                                }
                                SettingRow {
                                    label: "Cho phép phụ âm Z, W, J, F đầu từ";
                                    checked <=> root.opt-allow-zfwj;
                                    enabled: root.opt-check-spelling;
                                    toggled(v) => { root.setting-toggled("allow_zfwj", v); }
                                }
                                SettingRow {
                                    label: "Tạm tắt chính tả bằng nhấn đúp Ctrl";
                                    checked <=> root.opt-temp-off-spelling;
                                    enabled: root.opt-check-spelling;
                                    toggled(v) => { root.setting-toggled("temp_off_spelling", v); }
                                }
                                SettingRow {
                                    label: "Smart Switch — nhớ chế độ theo app";
                                    checked <=> root.opt-smart-switch;
                                    toggled(v) => { root.setting-toggled("smart_switch", v); }
                                }
                                SettingRow {
                                    label: "Tự nhớ bảng mã theo từng ứng dụng";
                                    checked <=> root.opt-remember-code;
                                    toggled(v) => { root.setting-toggled("remember_code", v); }
                                }
                                SettingRow {
                                    label: "Tự viết hoa chữ đầu câu";
                                    checked <=> root.opt-upper-first;
                                    toggled(v) => { root.setting-toggled("upper_first", v); }
                                }
                                SettingRow {
                                    label: "Hỗ trợ gõ song ngữ";
                                    checked <=> root.opt-other-language;
                                    toggled(v) => { root.setting-toggled("other_language", v); }
                                }
                                SettingRow {
                                    label: "Tạm tắt bộ gõ bằng phím Alt";
                                    checked <=> root.opt-temp-off-openkey;
                                    toggled(v) => { root.setting-toggled("temp_off_openkey", v); }
                                }
                            }
                        }
                    }
                }
            }

            // ── TAB 1: Gõ tắt ──────────────────────────────────────────────
            if root.active-tab == 1: VerticalLayout {
                spacing: 10px;

                Rectangle {
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;

                        Text {
                            text: "GÕ TẮT (MACRO)";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }
                        Rectangle { height: 8px; }

                        SettingRow {
                            label: "Bật tính năng gõ tắt (Macro)";
                            checked <=> root.opt-use-macro;
                            toggled(v) => { root.setting-toggled("use_macro", v); }
                        }
                        SettingRow {
                            label: "Cho phép gõ tắt khi đang gõ tiếng Anh";
                            checked <=> root.opt-macro-in-english;
                            enabled: root.opt-use-macro;
                            toggled(v) => { root.setting-toggled("macro_in_english", v); }
                        }
                        SettingRow {
                            label: "Tự đổi hoa/thường theo từ viết tắt";
                            checked <=> root.opt-macro-auto-caps;
                            enabled: root.opt-use-macro;
                            toggled(v) => { root.setting-toggled("macro_auto_caps", v); }
                        }
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;

                        Text {
                            text: "GÕ NHANH";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }
                        Rectangle { height: 8px; }

                        SettingRow {
                            label: "Gõ nhanh Telex";
                            sublabel: "cc→ch  gg→gi  kk→kh  nn→ng  tt→th…";
                            checked <=> root.opt-quick-telex;
                            toggled(v) => { root.setting-toggled("quick_telex", v); }
                        }
                        SettingRow {
                            label: "Phụ âm đầu thông minh";
                            sublabel: "f→ph  j→gi  w→qu";
                            checked <=> root.opt-quick-start-consonant;
                            toggled(v) => { root.setting-toggled("quick_start_consonant", v); }
                        }
                        SettingRow {
                            label: "Phụ âm cuối thông minh";
                            sublabel: "g→ng  h→nh  k→ch";
                            checked <=> root.opt-quick-end-consonant;
                            toggled(v) => { root.setting-toggled("quick_end_consonant", v); }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Quản lý danh sách từ gõ tắt";
                            font-size: 13px;
                            color: #64748b;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Btn {
                                label: "Mở bảng gõ tắt…";
                                primary: true;
                                clicked => { root.open-macro-table(); }
                            }
                            Btn {
                                label: "Công cụ chuyển mã…";
                                clicked => { root.open-convert-tool(); }
                            }
                        }
                    }
                }
            }

            // ── TAB 2: Hệ thống ─────────────────────────────────────────────
            if root.active-tab == 2: VerticalLayout {
                spacing: 10px;

                Rectangle {
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;

                        Text {
                            text: "KHỞI ĐỘNG & GIAO DIỆN";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }
                        Rectangle { height: 8px; }

                        SettingRow {
                            label: "Khởi động cùng Windows";
                            checked <=> root.opt-run-with-windows;
                            toggled(v) => { root.setting-toggled("run_with_windows", v); }
                        }
                        SettingRow {
                            label: "Hiện bảng điều khiển lúc khởi động";
                            checked <=> root.opt-show-on-startup;
                            toggled(v) => { root.setting-toggled("show_on_startup", v); }
                        }
                        SettingRow {
                            label: "Biểu tượng màu xám (hiện đại)";
                            checked <=> root.opt-modern-icon;
                            toggled(v) => { root.setting-toggled("modern_icon", v); }
                        }
                        SettingRow {
                            label: "Tạo icon tắt nhanh ngoài Desktop";
                            checked <=> root.opt-desktop-shortcut;
                            toggled(v) => { root.setting-toggled("desktop_shortcut", v); }
                        }
                    }
                }

                Rectangle {
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 0px;

                        Text {
                            text: "NÂNG CAO";
                            font-size: 11px;
                            font-weight: 700;
                            color: #94a3b8;
                            letter-spacing: 0.5px;
                        }
                        Rectangle { height: 8px; }

                        SettingRow {
                            label: "Chạy với quyền Admin";
                            checked <=> root.opt-run-as-admin;
                            toggled(v) => { root.setting-toggled("run_as_admin", v); }
                        }
                        SettingRow {
                            label: "Bản vá đặc biệt cho trình duyệt Chromium";
                            checked <=> root.opt-fix-chromium;
                            enabled: root.opt-fix-browser;
                            toggled(v) => { root.setting-toggled("fix_chromium", v); }
                        }
                        SettingRow {
                            label: "Dùng Clipboard thay vì SendInput";
                            checked <=> root.opt-use-clipboard;
                            toggled(v) => { root.setting-toggled("use_clipboard", v); }
                        }
                        SettingRow {
                            label: "Hỗ trợ ứng dụng Metro / UWP Store";
                            checked <=> root.opt-support-metro;
                            toggled(v) => { root.setting-toggled("support_metro", v); }
                        }
                        SettingRow {
                            label: "Tự động kiểm tra phiên bản mới";
                            checked <=> root.opt-check-update;
                            toggled(v) => { root.setting-toggled("check_update", v); }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ── TAB 3: Thông tin ─────────────────────────────────────────────
            if root.active-tab == 3: VerticalLayout {
                spacing: 10px;

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 32px;
                        spacing: 16px;
                        alignment: center;

                        Text {
                            text: "Minkey";
                            font-size: 28px;
                            font-weight: 800;
                            color: #1e293b;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Bộ gõ Tiếng Việt nguồn mở";
                            font-size: 14px;
                            color: #64748b;
                            horizontal-alignment: center;
                        }

                        Rectangle { height: 1px; background: #f1f5f9; }

                        Text {
                            text: "Bản làm lại hoàn toàn bằng Rust của bộ gõ OpenKey.\nGiữ nguyên 100% tính năng · Tốc độ tối đa · RAM cực thấp.";
                            font-size: 13px;
                            color: #475569;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Tác giả gốc OpenKey: Mai Vũ Tuyên\nRust Port & Modern UI: Liam & Antigravity\nGiấy phép: GNU GPL v3.0";
                            font-size: 11px;
                            color: #94a3b8;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            padding-top: 8px;
                            Btn {
                                label: "GitHub";
                                primary: true;
                                clicked => { root.open-github(); }
                            }
                            Btn {
                                label: "Kiểm tra cập nhật";
                                clicked => { root.check-update-clicked(); }
                            }
                        }
                    }
                }
            }

            // ── Footer buttons ─────────────────────────────────────────────
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                Btn {
                    label: "Cài đặt gốc";
                    clicked => { root.reset-defaults(); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        label: "Ẩn xuống khay";
                        primary: true;
                        clicked => { root.close-window(); }
                    }
                    Btn {
                        label: "Thoát";
                        clicked => { root.exit-app(); }
                    }
                }
            }
        }
    }
}


// ─── Macro Table Window ──────────────────────────────────────────────────────

export struct MacroItem {
    text: string,
    content: string,
}

export component MacroWindow inherits Window {
    title: "Minkey - Bảng Gõ Tắt";
    preferred-width: 600px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 480px;
    background: #f1f5f9;
    default-font-family: "Segoe UI";

    in-out property <[MacroItem]> items: [];
    in-out property <string> input-text: "";
    in-out property <string> input-content: "";
    in-out property <string> search-filter: "";
    in-out property <bool> opt-auto-caps: false;
    in-out property <bool> is-editing: false;

    callback add-or-update-macro(string, string);
    callback delete-macro(string);
    callback import-clicked();
    callback export-clicked();
    callback autocaps-toggled(bool);
    callback input-text-changed(string);
    callback search-filter-changed(string);
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Header
        Rectangle {
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Danh sách từ gõ tắt";
                        font-size: 15px;
                        font-weight: 700;
                        color: #1e293b;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        border-radius: 12px;
                        background: #eff6ff;
                        width: 60px;
                        height: 24px;
                        Text {
                            text: root.items.length + " mục";
                            font-size: 11px;
                            font-weight: 600;
                            color: #2563eb;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                TextInput_ {
                    placeholder: "🔍  Tìm kiếm từ gõ tắt…";
                    text <=> root.search-filter;
                    edited(v) => { root.search-filter-changed(v); }
                }
            }
        }

        // List
        Rectangle {
            vertical-stretch: 1;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 8px;
                spacing: 0px;

                // Table header
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: #f8fafc;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            width: 140px;
                            text: "Từ gõ tắt";
                            font-size: 11px;
                            font-weight: 700;
                            color: #64748b;
                            vertical-alignment: center;
                            letter-spacing: 0.5px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: "Nội dung thay thế";
                            font-size: 11px;
                            font-weight: 700;
                            color: #64748b;
                            vertical-alignment: center;
                            letter-spacing: 0.5px;
                        }
                    }
                }

                Rectangle { height: 4px; }

                ScrollView {
                    VerticalLayout {
                        spacing: 2px;

                        for item in root.items: Rectangle {
                            height: 34px;
                            border-radius: 6px;
                            background: row-ta.has-hover
                                ? #eff6ff
                                : (root.input-text == item.text ? #dbeafe : transparent);
                            animate background { duration: 80ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    width: 140px;
                                    text: item.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: #2563eb;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: item.content;
                                    font-size: 13px;
                                    color: #374151;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            row-ta := TouchArea {
                                clicked => {
                                    root.input-text = item.text;
                                    root.input-content = item.content;
                                    root.is-editing = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Input form
        Rectangle {
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: root.is-editing ? "SỬA TỪ GÕ TẮT" : "THÊM TỪ GÕ TẮT MỚI";
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 0.5px;
                }

                HorizontalLayout {
                    spacing: 10px;

                    VerticalLayout {
                        width: 150px;
                        spacing: 4px;
                        Text { text: "Từ gõ tắt:"; font-size: 12px; color: #475569; font-weight: 600; }
                        TextInput_ {
                            text <=> root.input-text;
                            placeholder: "vd: ko";
                            edited(v) => { root.input-text-changed(v); }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Nội dung thay thế:"; font-size: 12px; color: #475569; font-weight: 600; }
                        TextInput_ {
                            text <=> root.input-content;
                            placeholder: "vd: không";
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Toggle {
                            checked <=> root.opt-auto-caps;
                            toggled(v) => { root.autocaps-toggled(v); }
                        }
                        Text {
                            text: "Tự đổi hoa/thường theo từ viết tắt";
                            font-size: 12px;
                            color: #475569;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Btn {
                            label: root.is-editing ? "Lưu thay đổi" : "+ Thêm mới";
                            primary: true;
                            enabled: root.input-text != "";
                            clicked => {
                                root.add-or-update-macro(root.input-text, root.input-content);
                                root.input-text = "";
                                root.input-content = "";
                                root.is-editing = false;
                            }
                        }
                        Btn {
                            label: "Xoá";
                            enabled: root.input-text != "";
                            clicked => {
                                root.delete-macro(root.input-text);
                                root.input-text = "";
                                root.input-content = "";
                                root.is-editing = false;
                            }
                        }
                    }
                }
            }
        }

        // Footer
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                Btn { label: "Nạp từ file (.txt)…"; clicked => { root.import-clicked(); } }
                Btn { label: "Xuất ra file (.txt)…"; clicked => { root.export-clicked(); } }
            }
            Btn { label: "Đóng"; primary: true; clicked => { root.close-window(); } }
        }
    }
}


// ─── Convert Tool Window ─────────────────────────────────────────────────────

export component ConvertWindow inherits Window {
    title: "Minkey - Công Cụ Chuyển Mã";
    preferred-width: 540px;
    preferred-height: 520px;
    min-width: 480px;
    min-height: 460px;
    background: #f1f5f9;
    default-font-family: "Segoe UI";

    in-out property <int> selected-from-code: 0;
    in-out property <int> selected-to-code: 1;

    in-out property <bool> opt-to-all-caps: false;
    in-out property <bool> opt-to-all-non-caps: false;
    in-out property <bool> opt-to-caps-first-letter: false;
    in-out property <bool> opt-to-caps-each-word: false;
    in-out property <bool> opt-remove-mark: false;
    in-out property <bool> opt-dont-alert: false;

    in-out property <bool> switch-ctrl: false;
    in-out property <bool> switch-alt: false;
    in-out property <bool> switch-win: false;
    in-out property <bool> switch-shift: false;
    in-out property <string> switch-key: "";

    callback swap-codes();
    callback codes-changed();
    callback setting-changed(string, bool);
    callback hotkey-changed();
    callback convert-clicked();
    callback close-window();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Code table card
        Rectangle {
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "BẢNG MÃ CHUYỂN ĐỔI";
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 0.5px;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Nguồn (From):"; font-size: 12px; color: #475569; font-weight: 600; }
                        Dropdown {
                            model: ["Unicode dựng sẵn", "TCVN3 (ABC)", "VNI Windows", "Unicode Tổ hợp", "CP1258"];
                            current-index <=> root.selected-from-code;
                            selected(v) => { root.codes-changed(); }
                        }
                    }

                    VerticalLayout {
                        alignment: end;
                        padding-bottom: 0px;
                        swap-ta := TouchArea {
                            width: 60px;
                            height: 36px;
                            clicked => { root.swap-codes(); }
                        }
                        Rectangle {
                            x: swap-ta.x;
                            width: 60px;
                            height: 36px;
                            border-radius: 7px;
                            background: swap-ta.has-hover ? #eff6ff : #f8fafc;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            Text {
                                text: "⇄";
                                font-size: 16px;
                                color: #2563eb;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Đích (To):"; font-size: 12px; color: #475569; font-weight: 600; }
                        Dropdown {
                            model: ["Unicode dựng sẵn", "TCVN3 (ABC)", "VNI Windows", "Unicode Tổ hợp", "CP1258"];
                            current-index <=> root.selected-to-code;
                            selected(v) => { root.codes-changed(); }
                        }
                    }
                }
            }
        }

        // Options card
        Rectangle {
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 14px;
                spacing: 0px;

                Text {
                    text: "TÙY CHỌN BIẾN ĐỔI VĂN BẢN";
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 0.5px;
                }
                Rectangle { height: 8px; }

                SettingRow {
                    label: "Chuyển sang chữ HOA (ALL CAPS)";
                    checked <=> root.opt-to-all-caps;
                    toggled(v) => { root.setting-changed("to_all_caps", v); }
                }
                SettingRow {
                    label: "Chuyển sang chữ thường (all lower)";
                    checked <=> root.opt-to-all-non-caps;
                    toggled(v) => { root.setting-changed("to_all_non_caps", v); }
                }
                SettingRow {
                    label: "Viết hoa chữ đầu mỗi từ (Title Case)";
                    checked <=> root.opt-to-caps-each-word;
                    toggled(v) => { root.setting-changed("to_caps_each_word", v); }
                }
                SettingRow {
                    label: "Viết hoa chữ đầu câu (Sentence case)";
                    checked <=> root.opt-to-caps-first-letter;
                    toggled(v) => { root.setting-changed("to_caps_first_letter", v); }
                }

                Rectangle { height: 4px; }
                Rectangle { height: 1px; background: #f1f5f9; }
                Rectangle { height: 4px; }

                SettingRow {
                    label: "Loại bỏ dấu tiếng Việt";
                    checked <=> root.opt-remove-mark;
                    toggled(v) => { root.setting-changed("remove_mark", v); }
                }
                SettingRow {
                    label: "Không hiện thông báo sau khi chuyển xong";
                    checked <=> root.opt-dont-alert;
                    toggled(v) => { root.setting-changed("dont_alert", v); }
                }
            }
        }

        // Hotkey card
        Rectangle {
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "PHÍM TẮT CHUYỂN NHANH CLIPBOARD";
                    font-size: 11px;
                    font-weight: 700;
                    color: #94a3b8;
                    letter-spacing: 0.5px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    KeyBadge {
                        label: "Ctrl";
                        checked <=> root.switch-ctrl;
                        toggled(v) => { root.hotkey-changed(); }
                    }
                    KeyBadge {
                        label: "Alt";
                        checked <=> root.switch-alt;
                        toggled(v) => { root.hotkey-changed(); }
                    }
                    KeyBadge {
                        label: "Win";
                        checked <=> root.switch-win;
                        toggled(v) => { root.hotkey-changed(); }
                    }
                    KeyBadge {
                        label: "Shift";
                        checked <=> root.switch-shift;
                        toggled(v) => { root.hotkey-changed(); }
                    }

                    Text {
                        text: "+";
                        font-size: 14px;
                        font-weight: 700;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    TextInput_ {
                        text <=> root.switch-key;
                        width: 54px;
                        placeholder: "F9";
                        edited(v) => { root.hotkey-changed(); }
                    }
                }
            }
        }

        // Footer
        HorizontalLayout {
            alignment: space-between;
            Btn {
                label: "Chuyển mã Clipboard";
                primary: true;
                clicked => { root.convert-clicked(); }
            }
            Btn {
                label: "Đóng";
                clicked => { root.close-window(); }
            }
        }
    }
}
